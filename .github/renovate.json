{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rmuraix/renovate-config",
    "docker:pinDigests"
  ],
  "packageRules": [
    {
      "description": "Monthly digest/patch updates for OS and Node.js base images",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["debian", "node"],
      "matchUpdateTypes": ["digest", "minor", "patch"],
      "schedule": ["on the first day of the month"],
      "addLabels": ["monthly"],
      "automerge": true,
      "groupName": "monthly updates"
    }
  ]
}
